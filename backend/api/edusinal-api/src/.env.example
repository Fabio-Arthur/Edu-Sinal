# Conexão do banco de dados
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=senha
DB_NAME=edu_sinal
# true com o banco na nuvem (TiDB Cloud exige conexão criptografada)
DB_SSL=false

# Endereços do app que podem chamar a API (separados por vírgula).
# Use o MESMO nome (127.0.0.1 ou localhost) no app e na API, senão o login não funciona.
ORIGENS_PERMITIDAS=http://127.0.0.1:5500,http://localhost:5500

# true só com a API publicada em HTTPS
COOKIE_SEGURO=false
